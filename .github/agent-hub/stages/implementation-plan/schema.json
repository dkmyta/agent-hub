{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "needs-clarification"
      ]
    },
    "questions": {
      "description": "needs-clarification only: directional questions for the delivery lead or client.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "why",
          "who"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "who": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "plan": {
      "description": "ready only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "current_state",
        "approach",
        "acceptance_criteria",
        "changes",
        "steps",
        "dependencies",
        "testing",
        "security",
        "risks",
        "release",
        "resolved_questions",
        "assumptions"
      ],
      "properties": {
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "reason"
          ],
          "properties": {
            "size": {
              "type": "string",
              "enum": [
                "XS",
                "S",
                "M",
                "L",
                "XL"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "current_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "approach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "rationale",
            "alternatives"
          ],
          "properties": {
            "summary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "option",
                  "reason"
                ],
                "properties": {
                  "option": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "approach",
              "verification"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "approach": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "action",
              "summary",
              "details"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "add",
                  "modify",
                  "delete"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "minItems": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "details",
              "files",
              "criteria"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "automated",
            "commands",
            "manual"
          ],
          "properties": {
            "automated": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "manual": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "security": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "risk",
              "mitigation"
            ],
            "properties": {
              "risk": {
                "type": "string",
                "minLength": 1
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "rollback"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rollback": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resolved_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer",
              "evidence"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "revision_responses": {
      "type": "array",
      "description": "Only when revising after change requests: one entry per request, saying how it was handled.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "response"
        ],
        "properties": {
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The change request, briefly, in your own words."
          },
          "response": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800,
            "description": "What changed, the answer to a question, or why nothing changed (e.g. out of scope, unclear \u2014 say what's needed \u2014 or it needs a decision)."
          }
        }
      }
    }
  }
}
