{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "needs-clarification"
      ]
    },
    "questions": {
      "description": "needs-clarification only: directional questions for the delivery lead or client.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "why",
          "who"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "who": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "plan": {
      "description": "ready only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "current_state",
        "approach",
        "acceptance_criteria",
        "changes",
        "governance",
        "steps",
        "dependencies",
        "testing",
        "security",
        "observability",
        "risks",
        "release",
        "resolved_questions",
        "assumptions"
      ],
      "properties": {
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size",
            "reason"
          ],
          "properties": {
            "size": {
              "type": "string",
              "enum": [
                "XS",
                "S",
                "M",
                "L",
                "XL"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "current_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "approach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "rationale",
            "alternatives"
          ],
          "properties": {
            "summary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "option",
                  "reason"
                ],
                "properties": {
                  "option": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "approach",
              "verification"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "approach": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        },
        "changes": {
          "type": "array",
          "description": "Every file the build changes. Empty only when all the work is manual changes (governance.manual_changes).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "action",
              "summary",
              "details"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "enum": [
                  "add",
                  "modify",
                  "delete"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "description": "What the plan's changes include, for the person approving it and for the build stage's checks: the build may make sensitive changes only as this plan describes them.",
          "required": [
            "risk",
            "includes",
            "scope_patterns",
            "must_not_touch",
            "manual_changes"
          ],
          "properties": {
            "risk": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "reason"
              ],
              "properties": {
                "level": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "Why this level: what could go wrong and how widely it would be felt."
                }
              }
            },
            "includes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dependencies",
                "schema_or_migration",
                "public_api",
                "auth_or_permissions",
                "sensitive_data",
                "infrastructure",
                "workflow_or_ci",
                "configuration"
              ],
              "properties": {
                "dependencies": {
                  "type": "boolean",
                  "description": "Adds, removes or changes a dependency (name each in Dependencies & Configuration)"
                },
                "schema_or_migration": {
                  "type": "boolean",
                  "description": "Changes a database schema or adds a migration"
                },
                "public_api": {
                  "type": "boolean",
                  "description": "Changes a public API or contract other code or users rely on"
                },
                "auth_or_permissions": {
                  "type": "boolean",
                  "description": "Changes authentication, authorization or permissions"
                },
                "sensitive_data": {
                  "type": "boolean",
                  "description": "Changes how personal or other sensitive data is handled"
                },
                "infrastructure": {
                  "type": "boolean",
                  "description": "Changes infrastructure or deployment configuration"
                },
                "workflow_or_ci": {
                  "type": "boolean",
                  "description": "Changes CI or workflow files (the build can't; list them under manual_changes)"
                },
                "configuration": {
                  "type": "boolean",
                  "description": "Changes application configuration"
                }
              }
            },
            "scope_patterns": {
              "type": "array",
              "description": "Directories or glob patterns beyond Changes by File where changes are expected, e.g. tests/orders/** \u2014 empty if none.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "must_not_touch": {
              "type": "array",
              "description": "Files, directories or areas the change must leave alone \u2014 empty if none.",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "manual_changes": {
              "type": "array",
              "description": "Changes the hub can't make (.github/**, .claude/**, CODEOWNERS) that the work needs: a person makes them. Empty if none.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "change"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "change": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "details",
              "files",
              "criteria"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "automated",
            "commands",
            "manual"
          ],
          "properties": {
            "automated": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "manual": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "security": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observability": {
          "type": "array",
          "description": "Logs, metrics, alerts or dashboards the change needs \u2014 empty if none.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "risk",
              "mitigation"
            ],
            "properties": {
              "risk": {
                "type": "string",
                "minLength": 1
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "rollback"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rollback": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resolved_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "answer",
              "evidence"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "revision_responses": {
      "type": "array",
      "description": "Only when revising after change requests: one entry per request, with its id, saying how it was handled.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "request",
          "response"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "The id of the change request this answers, as the ticket gives it (\"request 411\" \u2192 \"411\")."
          },
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The change request, briefly, in your own words."
          },
          "response": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800,
            "description": "What changed, the answer to a question, or why nothing changed (e.g. out of scope, unclear \u2014 say what's needed \u2014 or it needs a decision)."
          }
        }
      }
    }
  }
}
