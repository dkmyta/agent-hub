{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "needs-details"
      ]
    },
    "missing": {
      "description": "needs-details only: what is missing and the questions the requester must answer.",
      "type": "string",
      "minLength": 1
    },
    "work_order": {
      "description": "ready only. Mirrors the ticket's sections.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "scope",
        "developer_notes",
        "risk"
      ],
      "properties": {
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "clarifications",
            "important_details"
          ],
          "properties": {
            "summary": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "clarifications": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "important_details": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acceptance_criteria",
            "out_of_scope"
          ],
          "properties": {
            "acceptance_criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "out_of_scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "developer_notes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codebase",
            "resources",
            "getting_started"
          ],
          "properties": {
            "codebase": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "relevance"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "relevance": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "topic",
                  "summary",
                  "sources"
                ],
                "properties": {
                  "topic": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "getting_started": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confidence",
            "customer_data",
            "open_questions"
          ],
          "properties": {
            "confidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "reason"
              ],
              "properties": {
                "level": {
                  "type": "string",
                  "enum": [
                    "Low",
                    "Medium",
                    "High"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "customer_data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contains",
                "reason"
              ],
              "properties": {
                "contains": {
                  "type": "string",
                  "enum": [
                    "Y",
                    "N"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "open_questions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "revision_responses": {
      "type": "array",
      "description": "Only when revising after change requests: one entry per request, with its id, saying how it was handled.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "request",
          "response"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[0-9]+$",
            "description": "The id of the change request this answers, as the ticket gives it (\"request 411\" \u2192 \"411\")."
          },
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The change request, briefly, in your own words."
          },
          "response": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800,
            "description": "What changed, the answer to a question, or why nothing changed (e.g. out of scope, unclear \u2014 say what's needed \u2014 or it needs a decision)."
          }
        }
      }
    },
    "clarification_settled": {
      "type": "boolean",
      "description": "Only when the ticket has an open \"Needs clarification\" comment from the implementation plan stage: true if this result answers every one of its questions (so a plan can be written), false if any is still open. Leave it out otherwise."
    }
  }
}
