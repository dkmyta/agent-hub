# The plan can't be built as written: the questions go into the plan, and the ticket back to Implementation Plan.
TICKET_FIXTURE=tickets/plan-approved.json
MOCK_STATUS="Implementation Plan Approved"
CHANGELOG_FIXTURE=changelog-approved.json
ATTACHMENTS_FIXTURE=attachments.json
ATTACHMENT_CONTENT_FIXTURE=plan.md
CLAUDE_FIXTURE=claude/ready.json
CLAUDE_FIXTURE_EDIT='.structured_output = {status: "needs-clarification", questions: [{question: "Should greet trim the name?", why: "The plan is silent on whitespace around names."}]}'
