# The review compacts away an acceptance criterion: the checks run on the
# reviewed plan, so it's rejected.
TICKET_FIXTURE=$WORK_ORDER_FIXTURES/tickets/work-order.json
CLAUDE_FIXTURE=claude/ready.json
CLAUDE_REVIEW_FIXTURE=claude/ready.json
CLAUDE_REVIEW_FIXTURE_EDIT='.structured_output |= {result: del(.plan.acceptance_criteria[0]),
  review: {note: "Merged overlapping criteria.", changes: ["Merged two criteria."], issues: [], outcome_changed: false, outcome_reason: ""}}'
MOCK_STATUS="Work Order Approved"
