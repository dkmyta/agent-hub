# The review improves the plan: the ticket and attachment get the reviewed
# version, and the attachment carries the review's notes.
TICKET_FIXTURE=$WORK_ORDER_FIXTURES/tickets/work-order.json
CLAUDE_FIXTURE=claude/ready.json
CLAUDE_REVIEW_FIXTURE=claude/ready.json
CLAUDE_REVIEW_FIXTURE_EDIT='.structured_output |= {
  result: (.plan.approach = {summary: ["Add a Quick Start section to README.md, linking each step to docs/setup.md."],
    rationale: "One short section keeps the README to about a page.", alternatives: []}),
  review: {note: "Verified 6 references against the code, removed an unneeded alternative and tightened the approach.",
    changes: ["Shortened the approach to one paragraph.", "Removed an alternative that did not apply."],
    issues: ["The approach repeated the steps."], outcome_changed: false, outcome_reason: ""}}'
MOCK_STATUS="Work Order Approved"
