#!/usr/bin/env bash
# Stand-in for the Claude Code CLI. `--version` prints a fixed version.
#
# The draft call records its arguments (claude-args.txt) and prompt
# (claude-prompt.txt) and prints $CLAUDE_FIXTURE (a recorded `claude
# --output-format json` result, or nothing if "none"); exits $CLAUDE_EXIT.
#
# The review call (recognised by its combined review prompt file) records
# claude-review-args.txt / claude-review-prompt.txt and prints
# $CLAUDE_REVIEW_FIXTURE — or, if that's unset or "approve", a review that
# returns the draft unchanged; exits $CLAUDE_REVIEW_EXIT.
#
# A further pass (agent_pass, recognised by its pass-prompt.md file — the
# build's code review) records claude-pass-args.txt / claude-pass-prompt.txt
# and prints $CLAUDE_PASS_FIXTURE — or, if that's unset, a review with no
# findings; "none" prints nothing. Exits $CLAUDE_PASS_EXIT.
#
# For the build, $CLAUDE_EDITS (a script, run in the checkout) stands in for
# the agent's changes to the repository.
if [ "$1" = --version ]; then echo "9.9.9 (Claude Code)"; exit 0; fi
# `auth status --json`: $CLAUDE_AUTH — account (default), api-key, both,
# bedrock or none — with an email and organisation that must never be logged.
if [ "$1" = auth ] && [ "$2" = status ]; then
  case "${CLAUDE_AUTH:-account}" in
    account) login=true key=null provider=firstParty ;;
    api-key) login=false key='"ANTHROPIC_API_KEY"' provider=firstParty ;;
    both) login=true key='"ANTHROPIC_API_KEY"' provider=firstParty ;;
    bedrock) login=false key=null provider=bedrock ;;
    none) login=false key=null provider=firstParty ;;
  esac
  printf '{"loggedIn": %s, "authMethod": "claude.ai", "apiProvider": "%s", "subscriptionType": "pro", "apiKeySource": %s, "email": "private-person@example.com", "orgName": "Private Org"}\n' "$login" "$provider" "$key"
  exit 0
fi
# `--help` lists restricted mode unless CLAUDE_NO_RESTRICTED=1 (an older version).
if [ "$1" = --help ]; then [ "${CLAUDE_NO_RESTRICTED:-}" = 1 ] || echo "  --restricted  Restricted mode"; exit 0; fi

case " $* " in
  *fix-check-pass-prompt.md*) pass=fix-check ;;
  *fix-pass-prompt.md*) pass=fix ;;
  *pass-prompt.md*) pass=pass ;;
  *review-prompt.md*) pass=review ;;
  *) pass=draft ;;
esac
suffix=""; [ "$pass" = draft ] || suffix="-$pass"
printf '%s\n' "$@" > "$RUNNER_TEMP/claude$suffix-args.txt"
# The environment the hub set for the session (sandboxed profiles).
env | grep -E '^(CLAUDE_CODE_SUBPROCESS_ENV_SCRUB|TMPDIR|XDG_CACHE_HOME|npm_config_cache|YARN_CACHE_FOLDER|PIP_CACHE_DIR)=' \
  | sort > "$RUNNER_TEMP/claude$suffix-env.txt" || true
while [ $# -gt 0 ]; do
  [ "$1" = -p ] && { printf '%s' "$2" > "$RUNNER_TEMP/claude$suffix-prompt.txt"; break; }
  shift
done

# The build's fix pass: $CLAUDE_FIX_EDITS (a script, run in the checkout)
# stands in for its changes; it prints $CLAUDE_FIX_FIXTURE. The fix check
# prints $CLAUDE_FIX_CHECK_FIXTURE. "none" prints nothing for either.
if [ "$pass" = fix ]; then
  [ -z "${CLAUDE_FIX_EDITS:-}" ] || bash -e "$CLAUDE_FIX_EDITS" || exit 98
  case "${CLAUDE_FIX_FIXTURE:-}" in
    "") jq -n '{type: "result", subtype: "success", is_error: false, total_cost_usd: 0.3, structured_output: {fixes: []}}' ;;
    none) ;;
    *) cat "$CLAUDE_FIX_FIXTURE" ;;
  esac
  exit 0
fi
if [ "$pass" = fix-check ]; then
  case "${CLAUDE_FIX_CHECK_FIXTURE:-}" in
    "") jq -n '{type: "result", subtype: "success", is_error: false, total_cost_usd: 0.1, structured_output: {checks: [], new_concerns: []}}' ;;
    none) ;;
    *) cat "$CLAUDE_FIX_CHECK_FIXTURE" ;;
  esac
  exit 0
fi

if [ "$pass" = pass ]; then
  case "${CLAUDE_PASS_FIXTURE:-}" in
    "") jq -n '{type: "result", subtype: "success", is_error: false, duration_ms: 30000, num_turns: 6, total_cost_usd: 0.4,
          modelUsage: {"claude-opus-5-5": {costUSD: 0.4}},
          structured_output: {summary: "The build matches the plan; no problems found.", findings: []}}' ;;
    none) ;;
    *) cat "$CLAUDE_PASS_FIXTURE" ;;
  esac
  exit "${CLAUDE_PASS_EXIT:-0}"
fi

if [ "$pass" = draft ]; then
  [ -z "${CLAUDE_EDITS:-}" ] || bash -e "$CLAUDE_EDITS" || exit 98
  [ "$CLAUDE_FIXTURE" = none ] || cat "$CLAUDE_FIXTURE"
  exit "${CLAUDE_EXIT:-0}"
fi

case "${CLAUDE_REVIEW_FIXTURE:-approve}" in
  approve)
    jq '{type, subtype, is_error: false, duration_ms: 20000, num_turns: 4, total_cost_usd: 0.2,
         modelUsage: {"claude-opus-5-5": {costUSD: 0.2}},
         structured_output: {result: .structured_output,
           review: {note: "Verified the draft against the code; no changes needed.",
                    changes: [], issues: [], outcome_changed: false, outcome_reason: ""}}}' \
      "$RUNNER_TEMP/agent-draft.json" ;;
  none) ;;
  *) cat "$CLAUDE_REVIEW_FIXTURE" ;;
esac
exit "${CLAUDE_REVIEW_EXIT:-0}"
