# The requester answered a Needs details comment with a /revise comment
# instead of editing the description (the Jira rule moved it to Work Order):
# a new work order from the form plus the comment; the needs-details comment
# and the change request are both resolved.
TICKET_FIXTURE=tickets/tbd.json
COMMENTS_FIXTURE=comments-details-in-comment.json
CLAUDE_FIXTURE=claude/ready.json
CLAUDE_FIXTURE_EDIT='.structured_output.revision_responses = [{request_id: "421", request: "Details added in a comment", response: "Used them to write the work order."}]'
MOCK_STATUS="Work Order"
